# Copy to .env and fill in. A missing key puts that agent in mock mode.
# The keys stay in the agent server (momo/server). The browser never receives them.

# Chat model: writes momo's replies. Every provider gets the same memory and
# returns the same shape (momo/server/chat/contract.ts), so you can switch.
# CHAT_PROVIDER=openai | claude | local. Empty: the first provider with a key.
CHAT_PROVIDER=
# OpenAI (chat provider "openai"). OPENAI_MODEL has no default: name the exact model ID.
# OPENAI_EFFORT: none | low | medium | high (gpt-6-luna has no "minimal"). Replies are spoken, so keep it low or none.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EFFORT=low

ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5

# Vision model: reads skin checks and product scans (momo/server/vision/contract.ts).
# VISION_PROVIDER=claude | local. Empty: the first provider with a key.
# Claude vision uses ANTHROPIC_API_KEY above. VISION_MODEL defaults to CHAT_MODEL.
VISION_PROVIDER=
VISION_MODEL=

# TypeSafe Jev - the checker. Labels skin feelings in each message.
TYPESAFE_API_KEY=
# Pin a model version for stable answers. jev-latest can change.
JEV_MODEL=jev-1.13.0
# JEV_API_URL=https://api.typesafe.ai/v1/systemone

# Qloo Taste AI - ranks brands for people like the user (city, age, gender).
QLOO_API_KEY=
# Hackathon keys use this URL. Production keys use https://api.qloo.com
QLOO_API_URL=https://hackathon.api.qloo.com

# YouCam (Perfect Corp) AI Skin Analysis. Key from https://yce.makeupar.com/api-console/en/api-keys/
# Test: npm run test:youcam -- quota   (units left are written to demo/youcam-quota.md)
YOUCAM_API_KEY=
# YOUCAM_API_URL=https://yce-api-01.makeupar.com

API_PORT=8787
